{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "db:seed:local": "wrangler d1 execute portfolio-db --local --file=seeds/projects.sql",
    "db:seed:remote": "wrangler d1 execute portfolio-db --remote --file=seeds/projects.sql"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}